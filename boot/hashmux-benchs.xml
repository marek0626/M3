<?xml version="1.0"?>
<config>
    <env>M3_GEM5_CFG=platform/gem5/configs/m3/rot.py M3_GEM5_ROT_CPU=TimingSimpleCPU</env>
    <mods>
        <mod name="fs" file="bench.img"/>
    </mods>
    <rot layers="brom,blau.bin,rosa.bin,rots.bin"/>
    <kernel args="kernel"/>
    <dom>
        <app args="root">
            <dom tile="core+kecacc+rot" unimux="1">
                <app args="rots" daemon="1">
                    <serv name="rot"/>
                    <mod name="rot-certificate.json" perm="r"/>
                </app>
            </dom>
            <dom>
                <app args="m3fs mem" daemon="1">
                    <serv name="m3fs"/>
                    <mod name="fs"/>
                </app>
            </dom>
            <dom>
                <app args="pager" usermem="768M">
                    <sess name="m3fs"/>
                    <mod name="fs" perm="r"/>
                    <mod name="tilemux" perm="r"/>
                    <tiles type="core" count="1"/>
                    <dom>
                        <app args="/bin/hashmuxbenchs">
                            <mount fs="m3fs" path="/"/>
                            <sess lname="hash-prepare" gname="rot"/>
                            <sess lname="hash-bench" gname="rot"/>
                            <sess lname="hash-client0" gname="rot"/>
                            <sess lname="hash-client1" gname="rot"/>
                            <sess lname="hash-latency" gname="rot"/>
                            <tiles type="core" count="2"/>
                        </app>
                    </dom>
                </app>
            </dom>
        </app>
    </dom>
</config>
