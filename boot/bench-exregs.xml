<?xml version="1.0"?>
<config>
    <env>M3_GEM5_CFG=platform/gem5/configs/m3/rot.py M3_GEM5_ROT_CPU=TimingSimpleCPU</env>
    <mods>
        <mod name="straccmux" file="bin/straccmux"/>
    </mods>
    <rot layers="brom,blau.bin,rosa.bin,rots.bin"/>
    <kernel args="kernel"/>
    <dom>
        <app args="root">
            <dom tile="riscv64+kecacc+rot|riscv32+kecacc+rot">
                <app args="rots no-zeroing" daemon="1">
                    <serv name="rot"/>
                    <mod name="rot-certificate.json" perm="r"/>
                </app>
            </dom>
            <dom>
                <app args="exregs -w 10 -r 100 -d 1024 -e 4">
                    <sess gname="rot" lname="hash" args="seed"/>
                    <tiles type="riscv32+coreacc|core" mux="straccmux"/>
                </app>
            </dom>
        </app>
    </dom>
</config>
