<?xml version="1.0"?>
<config>
    <env>M3_HW_M3LX=1 M3_HW_UARTNOBUF=1</env>
    <mods>
        <mod name="bbl" file="bbl"/>
        <mod name="initrd" file="rootfs.cpio"/>
        <mod name="dtb" file="m3lx.dtb"/>
    </mods>
    
    <kernel args="kernel"/>
    
    <dom>
        <app args="root">
            
            <dom tile="perf+nic|core" mux="bbl" muxmem="64M" initrd="initrd" dtb="dtb">
                <app args="/tcutest receiver  ">
                  <rgate name="chan" msgsize="64" slots="2" />
                </app>
            </dom>

            <dom>
                <app args="proxy">
                    <serv name="proxy_net"/> 
                    <sgate name="chan" label="1"/>
                </app>
            </dom>
