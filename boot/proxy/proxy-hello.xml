<?xml version="1.0"?>
<config>
  <mods>
    <mod name="bbl" file="bbl" />
    <mod name="initrd" file="rootfs.cpio" />
    <mod name="dtb1" file="m3lx1.dtb" />
  </mods>
  <kernel args="kernel" />
  <dom>
    <app args="root sem=net-udp sem=net-tcp">
      <dom>
        <app args="netechoserver" daemon="1">
          <sess lname="net" gname="proxy" args="bufs=1M socks=2 udp=1337 tcp=1338" />
          <sem name="net-udp" />
          <sem name="net-tcp" />
        </app>
      </dom>
      <dom tile="effi|core" mux="bbl" muxmem="64M" initrd="initrd" dtb="dtb1">
        <app args="/proxy">
          <serv name="proxy" />
        </app>
      </dom>
    </app>
  </dom>
</config>
