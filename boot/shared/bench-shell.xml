<?xml version="1.0"?>
<config>
    <mods>
        <mod name="fs" file="default.img"/>
    </mods>
    <kernel args="kernel"/>
    <dom>
        <app args="root maxcli=4 maxsrv=4" eps="512">
            <dom>
                <app args="m3fs mem" daemon="1">
                    <serv name="m3fs"/>
                    <mod name="fs"/>
                </app>
            </dom>
            <dom>
                <app args="pipes" daemon="1">
                    <serv name="pipes"/>
                </app>
            </dom>
            <app args="vterm -m 8" daemon="1">
                <serv name="vterm"/>
                <serial/>
            </app>
            <dom>
                <app args="pager maxcli=3 maxsrv=1">
                    <sess name="m3fs"/>
                    <mod name="fs" perm="r"/>
                    <mod name="tilemux" perm="r"/>
                    <app args="/bin/shell cat /test.txt | wc">
                        <mount fs="m3fs" path="/"/>
                        <sess name="pipes"/>
                        <sess name="vterm"/>
                        <tiles type="perf|core" count="2"/>
                    </app>
                </app>
            </dom>
        </app>
    </dom>
</config>
