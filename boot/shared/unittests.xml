<?xml version="1.0"?>
<config>
    <mods>
        <mod name="fs" file="default.img"/>
    </mods>
    <kernel args="kernel"/>
    <dom>
        <app args="root maxcli=4 maxsrv=2">
            <app args="pipes -m 8" daemon="1">
                <serv name="pipes"/>
            </app>
            <dom>
                <app args="m3fs mem" daemon="1">
                    <serv name="m3fs"/>
                    <mod name="fs"/>
                </app>
            </dom>
            <dom tile="perf|core">
                <app args="pager maxcli=4 maxsrv=1">
                    <sess name="m3fs"/>
                    <mod name="fs" perm="r"/>
                    <mod name="tilemux" perm="r"/>
                    <app args="/bin/unittests">
                        <mount fs="m3fs" path="/"/>
                        <sess lname="m3fs-clone" gname="m3fs"/>
                        <sess name="pipes"/>
                        <tiles type="perf|core" count="2"/>
                    </app>
                </app>
            </dom>
        </app>
    </dom>
</config>
