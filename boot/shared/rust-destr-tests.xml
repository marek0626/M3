<?xml version="1.0"?>
<config>
    <mods>
        <mod name="fs" file="default.img"/>
    </mods>
    <kernel args="kernel"/>
    <dom>
        <app args="root">
            <app args="m3fs mem" daemon="1">
                <serv name="m3fs"/>
                <mod name="fs"/>
            </app>
            <dom>
                <app args="pager">
                    <sess name="m3fs"/>
                    <mod name="fs" perm="r"/>
                    <mod name="tilemux" perm="r"/>
                    <tiles type="core" count="1"/>
                    <app args="/bin/rustdestrtests">
                        <mount fs="m3fs" path="/"/>
                        <serv name="test"/>
                        <sess name="test" dep="false"/>
                        <tiles type="core" count="2"/>
                    </app>
                </app>
            </dom>
        </app>
    </dom>
</config>
