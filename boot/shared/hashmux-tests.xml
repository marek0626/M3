<?xml version="1.0"?>
<config>
    <env>M3_GEM5_CFG=platform/gem5/configs/m3/rot.py M3_GEM5_ROT_CPU=TimingSimpleCPU</env>
    <mods>
        <mod name="fs" file="default.img"/>
    </mods>
    <rot layers="brom,blau.bin,rosa.bin,rots.bin"/>
    <kernel args="kernel"/>
    <dom>
        <app args="root">
            <dom tile="core+kecacc+rot">
                <app args="rots" daemon="1">
                    <serv name="rot"/>
                    <mod name="rot-certificate.json" perm="r"/>
                </app>
            </dom>
            <app args="pipes" daemon="1">
                <serv name="pipes"/>
            </app>
            <app args="m3fs mem" daemon="1">
                <serv name="m3fs"/>
                <mod name="fs"/>
            </app>
            <dom>
                <app args="pager">
                    <sess name="m3fs"/>
                    <mod name="fs" perm="r"/>
                    <mod name="tilemux" perm="r"/>
                    <tiles type="core" count="1"/>
                    <app args="/bin/rotshashtests">
                        <mount fs="m3fs" path="/"/>
                        <sess lname="hash" gname="rot"/>
                        <sess lname="hash1" gname="rot" args="20000"/>
                        <sess lname="hash2" gname="rot" args="20000"/>
                        <sess lname="hash3" gname="rot" args="20000"/>
                        <sess lname="hash4" gname="rot" args="20000"/>
                        <sess name="pipes"/>
                        <tiles type="core" count="1"/>
                    </app>
                </app>
            </dom>
        </app>
    </dom>
</config>
