<?xml version="1.0"?>
<config>
    <env>M3_GEM5_CFG=platform/gem5/configs/m3/default.py</env>
    <mods>
        <mod name="fs" file="default.img"/>
    </mods>
    <kernel args="kernel"/>
    <dom>
        <app args="root">
            <dom tile="core+kecacc">
                <app args="rots" daemon="1">
                    <serv name="rot"/>
                </app>
            </dom>
            <dom>
                <app args="m3fs mem" daemon="1">
                    <serv name="m3fs"/>
                    <mod name="fs"/>
                </app>
            </dom>
            <dom>
                <app args="pager">
                    <sess name="m3fs"/>
                    <sess name="rot"/>
                    <mod name="fs" perm="r"/>
                    <mod name="tilemux" perm="r"/>
                    <tiles type="perf|core|effi" count="3"/>
                    <dom tile="effi|perf|core">
                        <app args="/bin/sleep 2" attestation_id="1">
                            <tiles type="perf|core|effi" count="1"/>
                        </app>
                    </dom>
                </app>
            </dom>
        </app>
    </dom>
</config>
