<?xml version="1.0"?>
<config>
    <env>M3_GEM5_CFG=platform/gem5/configs/m3/rot.py M3_GEM5_ROT_CPU=TimingSimpleCPU</env>
    <mods>
        <mod name="fs" file="default.img"/>
    </mods>
    <rot layers="brom,blau.bin,rosa.bin,rots.bin"/>
    <kernel args="kernel"/>
    <dom>
        <app args="root">
            <dom tile="riscv64+kecacc+rot|riscv32+kecacc+rot">
                <app args="rots" daemon="1">
                    <serv name="rot"/>
                    <mod name="rot-certificate.json" perm="r"/>
                </app>
            </dom>
            <dom>
                <app args="m3fs mem" daemon="1">
                    <serv name="m3fs"/>
                    <mod name="fs"/>
                </app>
            </dom>
            <dom>
                <app args="pager">
                    <sess name="m3fs"/>
                    <serv name="evidence"/>
                    <sess name="rot" args="seed"/>
                    <mod name="fs" perm="r"/>
                    <mod name="tilemux" perm="r"/>
                    <tiles count="1" type="core"/>
                    <dom>
                        <app args="/bin/sleep 2" time="2s" attestation_id="42">
                            <mount fs="m3fs" path="/"/>
                        </app>
                    </dom>
                </app>
            </dom>
            <dom mux="teetest" tee="1">
                <app args="teetest 42">
                    <sess name="evidence"/>
                </app>
            </dom>
        </app>
    </dom>
</config>
