<?xml version="1.0"?>
<config>
    <env>M3_GEM5_CFG=platform/gem5/configs/m3/rot.py M3_GEM5_O3_CORES=2 M3_GEM5_MINOR_CORES=4</env>
    <mods>
        <mod name="fs" file="default.img"/>
    </mods>
    <rot layers="brom,blau.bin,rosa.bin"/>
    <kernel args="kernel"/>
    <dom>
        <app args="root">
            <dom tile="core+kecacc+rot" mux="rots" unimux="1">
                <app args="rots" daemon="1">
                    <serv name="rot"/>
                    <mod name="rot-certificate.json" perm="r"/>
                </app>
            </dom>
            <dom>
                <app args="m3fs mem" daemon="1">
                    <serv name="m3fs"/>
                    <mod name="fs"/>
                </app>
            </dom>
            <dom>
                <app args="pager">
                    <sess name="m3fs"/>
                    <serv name="evidence"/>
                    <sess name="rot"/>
                    <mod name="fs" perm="r"/>
                    <mod name="tilemux" perm="r"/>
                    <tiles count="2" type="core"/>
                    <dom>
                        <app args="/bin/rustalgobenchs" time="2s" attestation_id="1">
                            <mount fs="m3fs" path="/"/>
                        </app>
                    </dom>
                </app>
            </dom>
            <dom>
                <app args="teetest">
                    <sess name="evidence"/>
                </app>
            </dom>
        </app>
    </dom>
</config>
